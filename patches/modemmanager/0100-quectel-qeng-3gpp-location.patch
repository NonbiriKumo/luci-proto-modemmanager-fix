+/*****************************************************************************/
+/* +QENG="servingcell"                                                       */
+/*                                                                           */
+/* 部分移远模组（如 RM500U-CNV）不响应 +CREG/+CEREG，ModemManager 因此拿不到  */
+/* 3GPP 小区位置；数据只能通过私有命令 +QENG="servingcell" 获得，格式为：      */
+/*                                                                           */
+/*   LTE:      "servingcell",<state>,"LTE",<is_tdd>,<MCC>,<MNC>,<cellID>,     */
+/*             <PCID>,<earfcn>,<freq_band_ind>,<UL_bw>,<DL_bw>,<TAC>,...      */
+/*   NR5G-SA:  "servingcell",<state>,"NR5G-SA",<duplex>,<MCC>,<MNC>,<cellID>, */
+/*             <PCID>,<TAC>,<ARFCN>,<band>,<bw>,...                           */
+/*   WCDMA/GSM:"servingcell",<state>,"WCDMA",<MCC>,<MNC>,<LAC>,<cellID>,...   */
+/*                                                                           */
+/* MCC/MNC/CID/PCID 在 LTE 与 NR5G 中位置一致，TAC 位置不同；LAC 类制式则整体 */
+/* 前移一位。LTE/NR5G 的 cellID 与 TAC 是十六进制。                            */
+/*****************************************************************************/
+
+gboolean
+mm_quectel_parse_qeng_servingcell (const gchar  *response,
+                                   guint        *mcc,
+                                   guint        *mnc,
+                                   gulong       *lac,
+                                   gulong       *tac,
+                                   gulong       *cell_id,
+                                   GError      **error)
+{
+    g_auto(GStrv)     split = NULL;
+    g_autofree gchar *act = NULL;
+    const gchar      *p;
+    guint             n;
+    gint              idx_mcc = -1;
+    gint              idx_mnc = -1;
+    gint              idx_ci  = -1;
+    gint              idx_tac = -1;
+    gint              idx_lac = -1;
+
+    g_return_val_if_fail (response != NULL, FALSE);
+    g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+
+    p = mm_strip_tag (response, "+QENG:");
+    if (!p || !p[0]) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "missing +QENG response");
+        return FALSE;
+    }
+
+    /* 字段内不含逗号，去掉引号后直接按逗号切分 */
+    split = g_strsplit (p, ",", -1);
+    for (n = 0; split[n]; n++)
+        mm_strip_quotes (split[n]);
+
+    if (n < 4 || g_strcmp0 (split[0], "servingcell") != 0) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "not a +QENG servingcell response: '%s'", response);
+        return FALSE;
+    }
+
+    act = g_ascii_strup (split[2], -1);
+
+    if (g_strstr_len (act, -1, "LTE")) {
+        idx_mcc = 4; idx_mnc = 5; idx_ci = 6; idx_tac = 12;
+    } else if (g_strstr_len (act, -1, "NR5G")) {
+        idx_mcc = 4; idx_mnc = 5; idx_ci = 6; idx_tac = 8;
+    } else if (g_strstr_len (act, -1, "WCDMA") ||
+               g_strstr_len (act, -1, "UMTS") ||
+               g_strstr_len (act, -1, "GSM") ||
+               g_strstr_len (act, -1, "TDSCDMA")) {
+        idx_mcc = 3; idx_mnc = 4; idx_lac = 5; idx_ci = 6;
+    } else {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "unsupported access technology in +QENG response: '%s'", act);
+        return FALSE;
+    }
+
+    if ((guint) idx_mcc >= n || (guint) idx_mnc >= n || (guint) idx_ci >= n) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "truncated +QENG %s response: '%s'", act, response);
+        return FALSE;
+    }
+
+    if (mcc)
+        *mcc = (guint) g_ascii_strtoull (split[idx_mcc], NULL, 10);
+    if (mnc)
+        *mnc = (guint) g_ascii_strtoull (split[idx_mnc], NULL, 10);
+    if (cell_id)
+        *cell_id = (gulong) g_ascii_strtoull (split[idx_ci], NULL, 16);
+    if (tac && idx_tac >= 0 && (guint) idx_tac < n)
+        *tac = (gulong) g_ascii_strtoull (split[idx_tac], NULL, 16);
+    if (lac && idx_lac >= 0 && (guint) idx_lac < n)
+        *lac = (gulong) g_ascii_strtoull (split[idx_lac], NULL, 16);
+
+    return TRUE;
+}
