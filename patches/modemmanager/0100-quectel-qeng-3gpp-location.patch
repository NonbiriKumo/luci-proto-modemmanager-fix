 /*****************************************************************************/
+/*****************************************************************************/
+/* 3GPP cell location via +QENG="servingcell"                                */
+/*                                                                           */
+/* ModemManager 取 3GPP 小区位置靠的是 +CREG/+CEREG 的注册上报，而部分移远     */
+/* 模组（例如 RM500U-CNV）对这两条命令不返回任何内容，位置因此始终为空。数据    */
+/* 其实存在，但只通过私有命令 +QENG="servingcell" 暴露。                       */
+/*                                                                           */
+/* 这里在启用 3GPP 位置源时主动采集一次（让位置马上有值），并每 30 秒刷新，把   */
+/* 结果喂给 location 接口；关闭该位置源时停止刷新。                            */
+/*****************************************************************************/
+
+#define QENG_SERVINGCELL_FIRST_DELAY_SECS 2
+#define QENG_SERVINGCELL_POLL_SECS        30
+
+static void
+qeng_servingcell_update (MMBaseModem *modem,
+                         const gchar *response)
+{
+    GError *error = NULL;
+    guint   mcc = 0;
+    guint   mnc = 0;
+    gulong  lac = 0;
+    gulong  tac = 0;
+    gulong  cell_id = 0;
+    gchar  *operator_code;
+
+    if (!mm_quectel_parse_qeng_servingcell (response, &mcc, &mnc, &lac, &tac, &cell_id, &error)) {
+        mm_obj_dbg (modem, "couldn't parse +QENG servingcell response: %s", error->message);
+        g_error_free (error);
+        return;
+    }
+
+    if (mcc && mnc) {
+        operator_code = g_strdup_printf ("%u%02u", mcc, mnc);
+        mm_obj_dbg (modem, "3GPP location operator code from +QENG: '%s'", operator_code);
+        mm_iface_modem_location_3gpp_update_operator_code (MM_IFACE_MODEM_LOCATION (modem), operator_code);
+        g_free (operator_code);
+    }
+
+    if (lac || tac || cell_id) {
+        mm_obj_dbg (modem, "3GPP location from +QENG: lac %lu, tac %lu, cell id %lu", lac, tac, cell_id);
+        mm_iface_modem_location_3gpp_update_lac_tac_ci (MM_IFACE_MODEM_LOCATION (modem), lac, tac, cell_id);
+    }
+}
+
+static void
+qeng_servingcell_ready (MMBaseModem  *modem,
+                        GAsyncResult *res,
+                        gpointer      user_data)
+{
+    g_autofree gchar *response = NULL;
+    GError *error = NULL;
+
+    response = mm_base_modem_at_command_finish (modem, res, &error);
+    if (!response) {
+        mm_obj_dbg (modem, "+QENG=\"servingcell\" failed: %s", error->message);
+        g_error_free (error);
+        return;
+    }
+
+    qeng_servingcell_update (modem, response);
+}
+
+static void
+qeng_servingcell_run (MMBaseModem *modem)
+{
+    mm_base_modem_at_command (modem,
+                              "+QENG=\"servingcell\"",
+                              3,
+                              FALSE,
+                              (GAsyncReadyCallback)qeng_servingcell_ready,
+                              NULL);
+}
+
+static gboolean qeng_servingcell_ready_to_query (MMBaseModem *modem);
+
+static gboolean
+qeng_servingcell_poll_cb (gpointer user_data)
+{
+    MMBaseModem *modem = MM_BASE_MODEM (user_data);
+
+    /* 模组被停用/重新初始化期间跳过本轮 */
+    if (qeng_servingcell_ready_to_query (modem))
+        qeng_servingcell_run (modem);
+    return G_SOURCE_CONTINUE;
+}
+
+/* 模组是否已经过了初始化阶段、进入注册状态。
+ *
+ * 注意闸门必须放在 REGISTERED 而不是 ENABLED：在 enable（端口打开/关闭）过程中
+ * 向 AT 口下发命令，会让 ModemManager 在释放 AT 上下文时崩溃
+ * （backtrace 落在 at_command_context_free）。等注册完成后再查询就避开了这个窗口。 */
+static gboolean
+qeng_servingcell_ready_to_query (MMBaseModem *modem)
+{
+    MMModemState state = MM_MODEM_STATE_UNKNOWN;
+
+    g_object_get (modem, MM_IFACE_MODEM_STATE, &state, NULL);
+    return (state >= MM_MODEM_STATE_REGISTERED);
+}
+
+static gboolean
+qeng_servingcell_first_cb (gpointer user_data)
+{
+    MMBaseModem *modem = MM_BASE_MODEM (user_data);
+    Private     *priv;
+
+    priv = get_private (MM_SHARED_QUECTEL (modem));
+
+    /* 模组还在初始化时不要发 AT 命令：此时 ModemManager 自己也在密集使用
+     * AT 口，并发的命令会让它在释放 AT 上下文时崩溃。等进入 ENABLED 再说。 */
+    if (!qeng_servingcell_ready_to_query (modem)) {
+        priv->qeng_poll_id = g_timeout_add_seconds_full (G_PRIORITY_DEFAULT,
+                                                         QENG_SERVINGCELL_FIRST_DELAY_SECS,
+                                                         qeng_servingcell_first_cb,
+                                                         g_object_ref (modem),
+                                                         g_object_unref);
+        return G_SOURCE_REMOVE;
+    }
+
+    /* 先采集一次，然后转入常规间隔刷新 */
+    qeng_servingcell_run (modem);
+    priv->qeng_poll_id = g_timeout_add_seconds_full (G_PRIORITY_DEFAULT,
+                                                     QENG_SERVINGCELL_POLL_SECS,
+                                                     qeng_servingcell_poll_cb,
+                                                     g_object_ref (modem),
+                                                     g_object_unref);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+qeng_servingcell_poll_start (MMBaseModem *modem)
+{
+    Private *priv;
+
+    priv = get_private (MM_SHARED_QUECTEL (modem));
+    if (priv->qeng_poll_id)
+        return;
+
+    /* 注意：不能在 enable_location_gathering 的调用栈里立刻发 AT 并更新位置 ——
+     * 此时位置接口的自启用流程尚未结束，ModemManager 会在 AT 口关闭后崩溃。
+     * 因此先延迟一拍，再开始采集与周期刷新。 */
+    priv->qeng_poll_id = g_timeout_add_seconds_full (G_PRIORITY_DEFAULT,
+                                                     QENG_SERVINGCELL_FIRST_DELAY_SECS,
+                                                     qeng_servingcell_first_cb,
+                                                     g_object_ref (modem),
+                                                     g_object_unref);
+}
+
+static void
+qeng_servingcell_poll_stop (MMBaseModem *modem)
+{
+    Private *priv;
+
+    priv = get_private (MM_SHARED_QUECTEL (modem));
+    if (priv->qeng_poll_id) {
+        g_source_remove (priv->qeng_poll_id);
+        priv->qeng_poll_id = 0;
+    }
+}
